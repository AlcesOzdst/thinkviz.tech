# ThinkViz Environment Configuration Template
# Copy this file to .env.local for local development.

# Database URL (Prisma ORM)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your_api_key_here"

# Auth Session Secret
AUTH_SECRET="your-secure-random-secret-key-min-32-chars"

# Internal Service Secret for Automated Testing
INTERNAL_API_SECRET="your-internal-test-secret"

# Enterprise Role Passwords (Configured securely per deployment)
ADMIN_PASSWORD="replace_with_strong_admin_password"
EDUCATOR_PASSWORD="replace_with_strong_educator_password"
STUDENT_PASSWORD="replace_with_strong_student_password"
RESEARCHER_PASSWORD="replace_with_strong_researcher_password"
